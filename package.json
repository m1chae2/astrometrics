{
  "type": "module",
  "name": "astrometrics",
  "productName": "Astrometrics",
  "version": "0.2.0",
  "description": "Electron-based GUI for Astrometrics",
  "main": "electron/main.js",
  "scripts": {
    "test": "npm run type-check && vitest",
    "start": "electron .",
    "dev": "vite",
    "dev:ui": "sh -c 'vite --port ${DEV_PORT:-5173}'",
    "dev:electron": "sh -c 'wait-on http://127.0.0.1:${DEV_PORT:-5173} && ELECTRON_RENDERER_URL=http://127.0.0.1:${DEV_PORT:-5173} SKIP_BACKEND=1 NODE_ENV=development npx electron .'",
    "dev:local": "concurrently -k \"npm run dev:ui\" \"npm run dev:electron\"",
    "type-check": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint ui electron && npm run lint:css",
    "lint:css": "stylelint \"ui/**/*.css\"",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "electron-dev": "NODE_ENV=development electron .",
    "build:backend": ".venv/bin/pyinstaller backend/backend.spec --noconfirm --clean",
    "electron-forge:make": "npm run build && npm run build:backend && electron-forge make",
    "package:devflow": "cd .vscode/devflow && npx -y vsce package -o astrometrics-devflow.vsix && echo 'packaged at .vscode/devflow/astrometrics-devflow.vsix'",
    "install-playwright": "npx playwright install chromium",
    "docs:screenshots": "playwright test build/documentation/generate_screenshots.spec.ts",
    "prepare": "command -v pre-commit >/dev/null 2>&1 && pre-commit install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1chae2/astrometrics.git"
  },
  "keywords": [],
  "author": "Michael Coelho <macoelho25@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/m1chae2/astrometrics/issues"
  },
  "homepage": "https://github.com/m1chae2/astrometrics#readme",
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.104.4",
    "@uiw/react-codemirror": "^4.25.12",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "events": "^3.3.0",
    "jsfitsio": "^3.1.0",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "tar": "^7.5.6"
  }
}
