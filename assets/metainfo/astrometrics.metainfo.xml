  <url type="homepage">https://github.com/m1chae2/astrometrics</url>
  <url type="bugtracker">https://github.com/m1chae2/astrometrics/issues</url>
  <provides>
    <mediatype>image/fits</mediatype>
    <mediatype>application/fits</mediatype>
    <mediatype>application/x-fits</mediatype>
  </provides>
  <releases>
    <release version="0.2.0" date="2026-09-27" />
