{
  "mcpServers": {
    "astrometricslib-core": {
      "command": "node",
      "args": [
        "$CLAUDE_PROJECT_DIR/build/mcp/run_python_server.mjs",
        "mcp_servers.astrometrics_core"
      ],
      "cwd": "$CLAUDE_PROJECT_DIR",
      "env": {
        "PYTHONPATH": "$CLAUDE_PROJECT_DIR"
      }
    },
    "wayfindinglib-core": {
      "command": "node",
      "args": [
        "$CLAUDE_PROJECT_DIR/build/mcp/run_python_server.mjs",
        "mcp_servers.wayfinding_core"
      ],
      "cwd": "$CLAUDE_PROJECT_DIR",
      "env": {
        "PYTHONPATH": "$CLAUDE_PROJECT_DIR"
      }
    },
    "astrometrics-backend": {
      "command": "node",
      "args": [
        "$CLAUDE_PROJECT_DIR/build/mcp/run_python_server.mjs",
        "mcp_servers.backend"
      ],
      "cwd": "$CLAUDE_PROJECT_DIR",
      "env": {
        "ASTROMETRICS_API_BASE": "http://127.0.0.1:5000",
        "PYTHONPATH": "$CLAUDE_PROJECT_DIR"
      }
    },
    "astrometrics-gaps": {
      "command": "node",
      "args": [
        "$CLAUDE_PROJECT_DIR/build/mcp/run_python_server.mjs",
        "mcp_servers.gaps"
      ],
      "cwd": "$CLAUDE_PROJECT_DIR",
      "env": {
        "PYTHONPATH": "$CLAUDE_PROJECT_DIR"
      }
    }
  }
}
