<component type="desktop-application">
  <id>astrometrics.desktop</id>
  <name>Astrometrics</name>
  <summary>Astrophotography image viewer and analyzer</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Astrometrics is a desktop application for astrophotography image processing
      and spectroscopy. It supports FITS image viewing, stacking, astrometry and
      plate solving, photometry, and observatory control for telescope, focuser,
      and camera hardware.
    </p>
