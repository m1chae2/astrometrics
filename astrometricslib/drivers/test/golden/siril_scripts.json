 "imaging_bias_only_with_few_frames": {
  "result": null,
  "scripts": [
   [
    "setext fits",
    "set32bits",
    "cd <TMP>/work/GoldenTarget__golden_stack/biases",
    "convert bias -out=../process",
    "cd ../process",
    "load bias_00001.fits",
    "save bias_stacked",
    "cd <TMP>/work/GoldenTarget__golden_stack/flats",
    "convert flat -out=../process -fitseq",
    "cd ../process",
    "calibrate flat -bias=bias_stacked",
    "stack pp_flat rej 3 3 -norm=mul -out=flat_stacked",
    "cd <TMP>/work/GoldenTarget__golden_stack/lights",
    "convert light_source -out=../process -fitseq",
    "cd ../process",
    "calibrate light_source  -flat=flat_stacked -bias=bias_stacked",
    "setfindstar -relax=on",
    "register pp_light_source -2pass",
    "seqapplyreg pp_light_source",
    "stack r_pp_light_source rej 2.5000 2.0000 -weight=wfwhm -norm=addscale -out=result_stacked"
   ]
  ],
  "read_output_calls": [
   {
    "positional": [
     "GoldenTarget"
