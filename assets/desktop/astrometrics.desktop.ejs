<% /*
  Desktop entry template for the Linux .deb package.

  electron-installer-debian (used by @electron-forge/maker-deb) fills this in
  to make a desktop file named after the package ("astrometrics.desktop").
  forge.config.js then renames it to io.github.m1chae2.Astrometrics.desktop
  (applyFreedesktopIdentity), because the maker cannot set that name itself.
  Its built-in template has no way to add launcher actions, and it sets
  StartupWMClass to the product name ("Astrometrics"). We need the app ID
  there, because that is the Wayland app_id the window gets from
  app.setDesktopName in electron/platforms/linux.js#configureIdentity, and
  GNOME Shell only groups the running window under this launcher when they
  match.
  forge.config.js points the deb maker's desktopTemplate option at this file.
  (The template engine is lodash.template, so this note sits in a JS comment.)
*/ %>[Desktop Entry]
Name=<%= productName %>
GenericName=<%= genericName %>
Comment=Astrometrics Image Viewer and Analyzer
Exec=<%= name %> %U
Icon=<%= name %>
Type=Application
Terminal=false
StartupNotify=true
StartupWMClass=io.github.m1chae2.Astrometrics
Categories=<%= categories.join(';') %>;
MimeType=<%= mimeType.join(';') %>;
Actions=Planetarium;Observatory;Processing;

[Desktop Action Planetarium]
Name=Open Planetarium
Exec=<%= name %> --mode=Planetarium

[Desktop Action Observatory]
Name=Observatory Manager
Exec=<%= name %> --mode="Observatory Manager"

[Desktop Action Processing]
Name=Image Processing
Exec=<%= name %> --mode="Image Processing"
