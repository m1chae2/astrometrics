# Astrometrics configuration template.
#
# build/linux/setup_venv.sh copies this file to astrometrics.config on first
# run if no configuration exists yet. astrometrics.config itself is excluded
# from version control because it holds machine-specific paths and an
# astrometry.net API key; edit the copy, not this template.
#
# Every value below is a working default for the standard install
# (build/linux/install_ubuntu_deps.sh with no options), except the two
# marked EDIT ME. Installing Siril from Flatpak instead requires the two
# changes noted under [Processing.Siril].

[Image Library]
path = ./libraryIndex
# EDIT ME: absolute path to your own library of captured light frames.
frames_path = ./libraryIndex/frames

[Spectroscopy.Balmer Lines]
hα = 6562
hβ = 4861
hɣ = 4340
hδ = 4101
hε = 3970
hζ = 3889
hη = 3835

[Observatory.Filters]
owned = L, SPEC
analyzable = L, SPEC

[Observatory.Telescope]
hostname = localhost
focal_length_mm = 405
focal_ratio = 5.4
allow_commands = true
indi_port = 7624
remote_pictures_path = /home/stellarmate/Pictures

[Observatory.Constraints]
min_altitude = 0.0
max_altitude = 90.0

[Observatory.Camera]
models = Nikon D5300, ZWO ASI533MM Pro, ZWO ASI120MC-S
default_primary_camera = ZWO ASI533MM Pro
default_secondary_camera = ZWO ASI120MC-S

[Observatory.Camera.Nikon D5300]
name = Nikon D5300
pixel_size_μm = 3.89
sensor_width_px = 6000
sensor_height_px = 4000
grating_distance_mm = 75
sensor_min_wavelength = 350
sensor_max_wavelength = 900

[Observatory.Camera.ZWO ASI533MM Pro]
name = ZWO ASI533MM Pro
pixel_size_μm = 3.76
sensor_width_px = 3008
sensor_height_px = 3008
grating_distance_mm = 16.49
sensor_min_wavelength = 300
sensor_max_wavelength = 1000
dispersion_orientation = vertical
dispersion_direction = positive
dispersion_start_px = 334.4
grating_lines_per_mm = 200
dispersion_offset_x = 0.0

[Observatory.Camera.ZWO ASI120MC-S]
name = ZWO ASI120MC-S
pixel_size_μm = 3.75
sensor_width_px = 1280
sensor_height_px = 960
grating_distance_mm = 0
sensor_min_wavelength = 400
sensor_max_wavelength = 700

[Processing.Astrometry.Online Solver]
# EDIT ME: your astrometry.net API key, from
# https://nova.astrometry.net/api_help. Plate solving needs either this key
# or the local solver below; the standard install provides neither, so set
# one of the two before running astrometry. Leaving this blank falls back to
# the local solver, which requires installing it first with
# build/linux/install_ubuntu_deps.sh --with-local-solver.
api_key =

[Processing.Astrometry.Local Solver]
index_path = /usr/share/astrometry
autoindex = true
cpulimit = 300

[Processing.Siril]
# Match this to whichever --siril-source you passed to
# build/linux/install_ubuntu_deps.sh (the script prints the right value
# when it finishes; it does not edit this file for you):
#   apt (default):  siril-cli
#   flatpak:        flatpak run --command=siril-cli org.siril.Siril
# Either way, use the -cli entry point, not plain "siril" or
# "flatpak run org.siril.Siril" -- those launch the GUI build, which
# needs a display connection even for headless pipe-mode stacking.
siril_executable = siril-cli
rejection_sigma_low = 3.0
rejection_sigma_high = 3.0
filter_wfwhm_percentile =
filter_round_percentile =
# Blank by default, because the default apt install cannot use it:
# weighting requires a Siril new enough to support `stack`'s -weight=
# argument, and Ubuntu's package (1.2.1) is not, so stacking fails with
# "Unexpected argument to stacking `-weight=wfwhm'". If you installed via
# --siril-source=flatpak (see build/linux/install_ubuntu_deps.sh), set
# this to wfwhm to weight each frame by its measured star sharpness.
stack_weight =
generate_rejmap = true
rejection_sigma_mode = adaptive
background_homogeneity_check_enabled = true
auto_open_gui = false

[Processing.AsteroidRecovery]
detection_fwhm_px = 4.0
detection_threshold_sigma = 5.0
min_frames_for_persistence = 3
pixel_match_tolerance_px = 1.5
sky_match_tolerance_arcsec = 3.0
rate_min_arcsec_per_hour = 1.0
rate_max_arcsec_per_hour = 300.0
rate_linearity_r_squared_min = 0.98
ephemeris_cross_match_radius_arcsec = 10.0
ephemeris_maximum_visual_magnitude = 16.0
mpc_observatory_code = 500

[Processing.Parallelism]
target_workers = auto
siril_concurrency = 2
photometry_workers = auto
worker_niceness = 10
analysis_concurrency = 2

[Frontend]
enable_observatory = true
enable_planetarium = true
enable_astronomy = true
enable_observation = false

[Library]
# Legacy section, read only as a fallback for configurations written before
# [Image Library] existed. siril_executable is deliberately not repeated
# here: get_siril_executable() always prefers [Processing.Siril], so a copy
# in this section would never be read and would drift out of sync with the
# one that is.
path = libraryIndex
frames_path = libraryIndex/frames
