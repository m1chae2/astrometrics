{
  "type": "module",
  "name": "astrometrics",
  "productName": "Astrometrics",
  "version": "0.2.0",
  "description": "Electron-based GUI for Astrometrics",
  "main": "electron/main.js",
  "scripts": {
    "test": "npm run type-check && vitest",
    "start": "electron .",
    "dev": "vite",
    "dev:ui": "sh -c 'vite --port ${DEV_PORT:-5173}'",
    "dev:electron": "sh -c 'wait-on http://127.0.0.1:${DEV_PORT:-5173} && ELECTRON_RENDERER_URL=http://127.0.0.1:${DEV_PORT:-5173} SKIP_BACKEND=1 NODE_ENV=development npx electron .'",
    "dev:local": "concurrently -k \"npm run dev:ui\" \"npm run dev:electron\"",
    "type-check": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint ui",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "electron-dev": "NODE_ENV=development electron .",
    "build:backend": ".venv/bin/pyinstaller backend/backend.spec --noconfirm --clean",
    "electron-forge:make": "npm run build && npm run build:backend && electron-forge make",
    "package:devflow": "cd .vscode/devflow && npx -y vsce package -o astrometrics-devflow.vsix && echo 'packaged at .vscode/devflow/astrometrics-devflow.vsix'",
    "install-playwright": "npx playwright install chromium",
    "docs:screenshots": "playwright test build/documentation/generate_screenshots.spec.ts",
    "prepare": "command -v pre-commit >/dev/null 2>&1 && pre-commit install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1chae2/astrometrics.git"
  },
  "keywords": [],
  "author": "Michael Coelho <macoelho25@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/m1chae2/astrometrics/issues"
  },
  "homepage": "https://github.com/m1chae2/astrometrics#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.101.2",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "jsfitsio": "^2.0.0",
    "plotly.js-dist-min": "^3.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.3",
    "electron": "^40.10.5",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "jsdom": "^27.4.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "tar": "^7.5.6"
  }
}
