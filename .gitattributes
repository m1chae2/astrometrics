*.nc filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.fit filter=lfs diff=lfs merge=lfs -text
*.fits filter=lfs diff=lfs merge=lfs -text

# Shell scripts keep Unix line endings on every checkout, including Windows ones that
# convert other text files to CRLF, so they still run in Git Bash and WSL.
*.sh text eol=lf
