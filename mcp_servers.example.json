{
  "mcpServers": {
    "astrometricslib-core": {
      "command": "/path/to/astrometrics/.venv/bin/python",
      "args": [
        "-m",
        "astrometricslib.mcp"
      ],
      "cwd": "/path/to/astrometrics",
      "env": {
        "ASTROMETRICS_MCP_PROFILE": "developer",
        "PYTHONPATH": "/path/to/astrometrics"
      }
    },
    "wayfindinglib-core": {
      "command": "/path/to/astrometrics/.venv/bin/python",
      "args": [
        "-m",
        "wayfindinglib.mcp"
      ],
      "cwd": "/path/to/astrometrics",
      "env": {
        "ASTROMETRICS_MCP_PROFILE": "investigator",
        "PYTHONPATH": "/path/to/astrometrics"
      }
    },
    "astrometrics-backend": {
      "command": "/path/to/astrometrics/.venv/bin/python",
      "args": [
        "-m",
        "backend.mcp"
      ],
      "cwd": "/path/to/astrometrics",
      "env": {
        "ASTROMETRICS_API_BASE": "http://127.0.0.1:5000",
        "ASTROMETRICS_MCP_PROFILE": "investigator",
        "MPLCONFIGDIR": "/tmp/matplotlib",
        "PYTHONPATH": "/path/to/astrometrics"
      }
    },
    "astrometrics-gaps": {
      "command": "/path/to/astrometrics/.venv/bin/python",
      "args": [
        "-m",
        "backend.mcp.gaps"
      ],
      "cwd": "/path/to/astrometrics",
      "env": {
        "PYTHONPATH": "/path/to/astrometrics"
      }
    },
    "astrometrics-ui": {
      "command": "node",
      "args": [
        "/path/to/astrometrics/ui/mcp/dist/index.js"
      ],
      "cwd": "/path/to/astrometrics",
      "env": {
        "ASTROMETRICS_MCP_PROFILE": "developer"
      }
    }
  }
}
